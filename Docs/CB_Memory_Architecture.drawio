<mxfile host="app.diagrams.net"><diagram id="memory" name="Memory architecture"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Company Brain memory: a living map that stays fast for decades" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1040" height="36" as="geometry"/></mxCell><mxCell id="src" value="1 · Sources (grow without limit)" style="swimlane;startSize=26;fillColor=#fff0e6;strokeColor=#d79b00;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1040" height="110" as="geometry"/></mxCell><mxCell id="conn" value="Connectors&lt;br&gt;&lt;small&gt;email · chat · ERP · CRM&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="src"><mxGeometry x="30" y="36" width="260" height="60" as="geometry"/></mxCell><mxCell id="docs" value="Documents and files&lt;br&gt;&lt;small&gt;contracts · policies · reports&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="src"><mxGeometry x="390" y="36" width="260" height="60" as="geometry"/></mxCell><mxCell id="commons" value="Public commons&lt;br&gt;&lt;small&gt;laws · markets · competitors&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="src"><mxGeometry x="750" y="36" width="260" height="60" as="geometry"/></mxCell><mxCell id="intake" value="2 · Intake: classify once, on the way in" style="swimlane;startSize=26;fillColor=#eef3fb;strokeColor=#6c8ebf;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1040" height="110" as="geometry"/></mxCell><mxCell id="capture" value="Capture and mask&lt;br&gt;&lt;small&gt;S1 · S2&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="intake"><mxGeometry x="30" y="36" width="260" height="60" as="geometry"/></mxCell><mxCell id="classify" value="Tag five ways&lt;br&gt;&lt;small&gt;type · domain · entity · time · sensitivity&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="intake"><mxGeometry x="390" y="36" width="260" height="60" as="geometry"/></mxCell><mxCell id="resolve" value="Resolve entity, dedup&lt;br&gt;&lt;small&gt;one node per real thing&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="intake"><mxGeometry x="750" y="36" width="260" height="60" as="geometry"/></mxCell><mxCell id="mem" value="3 · Memory: four tiers, each with a fixed budget" style="swimlane;startSize=26;fillColor=#eef7ee;strokeColor=#82b366;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1040" height="140" as="geometry"/></mxCell><mxCell id="hot" value="&lt;b&gt;Hot working set&lt;/b&gt;&lt;br&gt;&lt;small&gt;Valkey + hot index&lt;br&gt;capped per tenant&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="mem"><mxGeometry x="20" y="40" width="230" height="84" as="geometry"/></mxCell><mxCell id="warm" value="&lt;b&gt;Warm map&lt;/b&gt;&lt;br&gt;&lt;small&gt;entities · typed links · facts&lt;br&gt;Postgres, by tenant · domain · time&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="mem"><mxGeometry x="275" y="40" width="230" height="84" as="geometry"/></mxCell><mxCell id="cold" value="&lt;b&gt;Cold archive&lt;/b&gt;&lt;br&gt;&lt;small&gt;S3, compressed&lt;br&gt;closed facts · old chunks&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="mem"><mxGeometry x="530" y="40" width="230" height="84" as="geometry"/></mxCell><mxCell id="raw" value="&lt;b&gt;Raw vault&lt;/b&gt;&lt;br&gt;&lt;small&gt;S3, never edited&lt;br&gt;deleted on a retention clock&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="mem"><mxGeometry x="790" y="40" width="230" height="84" as="geometry"/></mxCell><mxCell id="dist" value="4 · Distiller (every night)" style="swimlane;startSize=26;fillColor=#fffaeb;strokeColor=#d6b656;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="500" height="160" as="geometry"/></mxCell><mxCell id="score" value="Score what matters&lt;br&gt;&lt;small&gt;use × recency × risk × trust × links&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dist"><mxGeometry x="20" y="38" width="220" height="52" as="geometry"/></mxCell><mxCell id="merge" value="Merge and summarize&lt;br&gt;&lt;small&gt;many events become one fact&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dist"><mxGeometry x="260" y="38" width="220" height="52" as="geometry"/></mxCell><mxCell id="move" value="Promote or demote&lt;br&gt;&lt;small&gt;keep each tier inside budget&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dist"><mxGeometry x="20" y="100" width="220" height="52" as="geometry"/></mxCell><mxCell id="expire" value="Expire raw&lt;br&gt;&lt;small&gt;by retention rule&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dist"><mxGeometry x="260" y="100" width="220" height="52" as="geometry"/></mxCell><mxCell id="ret" value="5 · Retrieval (every question)" style="swimlane;startSize=26;fillColor=#eef3fb;strokeColor=#6c8ebf;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="500" height="160" as="geometry"/></mxCell><mxCell id="router" value="Route&lt;br&gt;&lt;small&gt;domain + entities, from the map&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ret"><mxGeometry x="20" y="38" width="220" height="52" as="geometry"/></mxCell><mxCell id="search" value="Scoped search&lt;br&gt;&lt;small&gt;hot first · at most 2 hops&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ret"><mxGeometry x="260" y="38" width="220" height="52" as="geometry"/></mxCell><mxCell id="budget" value="Rerank, fit budget&lt;br&gt;&lt;small&gt;about 6k tokens, always&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ret"><mxGeometry x="260" y="100" width="220" height="52" as="geometry"/></mxCell><mxCell id="agent" value="Agent or person&lt;br&gt;&lt;small&gt;cited answer&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ret"><mxGeometry x="20" y="100" width="220" height="52" as="geometry"/></mxCell><mxCell id="legend" value="Solid: data flows in · Dashed: maintenance and lookups · Purple: kept for audit only, never searched" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1040" height="30" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="conn" target="capture"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="docs" target="classify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="intake" source="capture" target="classify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="intake" source="classify" target="resolve"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="shared, read only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;labelBackgroundColor=default;" edge="1" parent="1" source="commons" target="resolve"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="facts + links" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;" edge="1" parent="1" source="resolve" target="warm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="original" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;labelBackgroundColor=default;" edge="1" parent="1" source="capture" target="raw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="promote" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;labelBackgroundColor=default;" edge="1" parent="mem" source="warm" target="hot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="demote" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;labelBackgroundColor=default;" edge="1" parent="mem" source="warm" target="cold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="dist" source="score" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="dist" source="merge" target="move"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="dist" source="move" target="expire"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="prunes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;labelBackgroundColor=default;" edge="1" parent="1" source="dist" target="warm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ret" source="router" target="search"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ret" source="search" target="budget"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ret" source="budget" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="looks up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;labelBackgroundColor=default;" edge="1" parent="1" source="ret" target="warm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="trend" value="&lt;b&gt;Signal timeline · spikes&lt;/b&gt;&lt;br&gt;&lt;small&gt;weekly counts by entity and segment · Trends tab&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="500" height="70" as="geometry"/></mxCell><mxCell id="owner" value="Owner alerted&lt;br&gt;&lt;small&gt;unusual week, with the cases&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="580" y="710" width="500" height="70" as="geometry"/></mxCell><mxCell id="e18" value="counts weekly" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;labelBackgroundColor=default;" edge="1" parent="1" source="dist" target="trend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="spike" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;" edge="1" parent="1" source="trend" target="owner"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
