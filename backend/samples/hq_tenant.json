{
  "_about": "Finebase HQ: the tenant the real backend serves to the console (step 9). The demo tenants (demo-fbl, Scale Demo) stay on mock data. Rules, skills, policy, payments and knowledge start from the golden seed until connectors bring real data; this file overrides tenant details, people and clusters.",
  "tenant": {
    "id": "finebase-hq",
    "name": "Finebase HQ",
    "currency": "LKR",
    "timezone": "Asia/Colombo",
    "locale": "en-LK",
    "brand": {"primary": "#4338ca", "mark": "FH"}
  },
  "seed_overrides": {
    "tenant_id": "finebase-hq", "env": "production",
    "filing_rules": [
      {"id": "fr_contracts", "match": "contract|agreement|\\bmsa\\b|\\bnda\\b", "type": "contract", "sensitivity": "confidential", "retention_days": 2555, "is_sample": true},
      {"id": "fr_invoices", "match": "invoice|receipt|\\bbill\\b", "type": "invoice", "sensitivity": "confidential", "retention_days": 2555, "is_sample": true},
      {"id": "fr_statements", "match": "bank statement|statement", "type": "statement", "sensitivity": "restricted", "retention_days": 2555, "is_sample": true},
      {"id": "fr_policies", "match": "policy|terms|handbook|procedure", "type": "policy", "sensitivity": "internal", "retention_days": 1825, "is_sample": true},
      {"id": "fr_pricing", "match": "pric(e|ing)|rate card", "type": "pricing", "sensitivity": "internal", "retention_days": 1095, "is_sample": true},
      {"id": "fr_reports", "match": "report|export", "type": "report", "sensitivity": "internal", "retention_days": 1095, "is_sample": true}
    ]
  },
  "people": {
    "h-pamuditha": {"tier": "L1", "roles": ["founder", "dri", "leader", "head_of_cs"], "delegate": null, "name": "Pamuditha Senanayake", "title": "Founder", "color": "#4338ca", "address": "sir"},
    "h-udayanga": {"tier": "L2", "roles": ["steward"], "delegate": "h-pamuditha", "name": "Udayanga Weerakoon", "title": "Steward", "color": "#0f766e"},
    "h-imashi": {"tier": "L2", "roles": ["steward"], "delegate": "h-pamuditha", "name": "Imashi Dissanayake", "title": "Steward", "color": "#b45309"}
  },
  "clusters": [
    {"id": "customer_care", "name": "Customer care", "description": "Support inbox, refunds and customer replies.", "dri": "h-pamuditha"}
  ],
  "sensors": {
    "conn_gmail_support": {"name": "Support inbox", "kind": "inbox", "cluster": "customer_care", "events": ["email.received"], "subscribers": ["agent_refund_worker"], "personal_data": true},
    "conn_web_chat": {"name": "Website chat", "kind": "chat", "cluster": "customer_care", "events": ["chat.message"], "subscribers": ["agent_refund_worker"], "personal_data": true},
    "conn_upload_console": {"name": "Console uploads", "kind": "documents", "cluster": "customer_care", "events": ["document.uploaded"], "subscribers": [], "personal_data": false}
  },
  "graph_labels": {
    "agents": {
      "agent_refund_worker": {"name": "Refund worker", "description": "Handles refund requests from email and chat, inside the refund policy.", "kind": "worker", "dri": "h-pamuditha"},
      "agent_billing_helper": {"name": "Billing helper", "description": "Answers invoice and billing questions from the documents.", "kind": "worker", "dri": "h-pamuditha"}
    },
    "policies": {"policy_refund": {"name": "Refund policy", "dri": "h-pamuditha", "skills": ["skill_refund_handling"]}},
    "skill_dri": "h-pamuditha"
  }
}
