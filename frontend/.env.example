# Copy to .env.local and adjust. No secrets ever go in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_MOCKING=enabled          # disabled = call the real backend
NEXT_PUBLIC_API_BASE_URL=                # e.g. http://localhost:8000 when mocks are disabled
NEXT_PUBLIC_LIVE_SOURCE=mock             # sse = EventSource on /api/t/{tenant}/stream
NEXT_PUBLIC_AUTH_PROVIDER=mock           # sso when the SSO adapter is wired
NEXT_PUBLIC_FLAG_RESEARCH=enabled        # disabled removes the Research Console routes, nav and bundles
NEXT_PUBLIC_ROLE_SWITCHER=enabled        # disabled strips persona impersonation
NEXT_PUBLIC_MOCK_STREAM=on               # off pauses the mock live event stream
NEXT_PUBLIC_MOCK_LATENCY_MS=120          # simulated API latency for mocks
