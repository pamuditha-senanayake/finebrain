# Non secret feature flags for `next build`. Override in the deployment environment.
# Set NEXT_PUBLIC_FLAG_RESEARCH=disabled to remove the Research Console completely.
# Set NEXT_PUBLIC_API_MOCKING=disabled and NEXT_PUBLIC_API_BASE_URL to use the real backend.
# Set NEXT_PUBLIC_ROLE_SWITCHER=disabled for production deployments.
NEXT_PUBLIC_API_MOCKING=enabled
NEXT_PUBLIC_FLAG_RESEARCH=enabled
NEXT_PUBLIC_ROLE_SWITCHER=enabled
